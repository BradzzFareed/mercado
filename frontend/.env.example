# Frontend environment
# Copy to .env and fill in real values. .env is gitignored.

# Leave empty in development to use the Vite proxy (/api -> http://127.0.0.1:8000).
# In production, set the full origin of the FastAPI backend, e.g. https://api.example.com
VITE_API_BASE=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY= 

# Dev-only: set to 1 to skip the Supabase login gate so pages render without
# credentials. Leave at 0 (or unset) for normal auth. Never enable in production.
VITE_DEV_BYPASS_AUTH=0
